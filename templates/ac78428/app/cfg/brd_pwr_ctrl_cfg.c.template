#define INIT_PWR_CTRL_CFG(DoEnable_, group_, pin_, reverse_) \
    { \
        .DoEnable = DoEnable_, \
        .group = kDrvPortGroup##group_, \
        .pin = kDrvPortPin##pin_, \
        .reverse = reverse_, \
    }

#define INIT_PWR_CTRL_ITEM(id_, cfg_, enabled_) \
    { \
        .id = id_, \
        .cfg = &g_brd_pwr_ctrl_cfgs_[cfg_], \
        .enabled = enabled_, \
    }

#define INIT_PWR_CTRL_BASE(id_, cfg_, ref_) \
    { \
        .id = id_, \
        .cfg = &g_brd_pwr_ctrl_base_cfgs_[cfg_], \
        .ref = ref_, \
    }


static void Brd_PwrCtrlSet5vPerEnable(Bool enable);
static void Brd_PwrCtrlSet3v3PerEnable(Bool enable);
static void Brd_PwrCtrlSet5VMainEnable(Bool enable);

static const Brd_TPwrCtrlCfg g_brd_pwr_ctrl_cfgs_[] =
{{DATA_G_BRD_PWR_CTRL_CFGS_}};

/// 公共电源配置~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
static const Brd_TPwrCtrlCfg g_brd_pwr_ctrl_base_cfgs_[] =
 {{DATA_G_BRD_PWR_CTRL_BASE_CFGS_}};

static Brd_TPwrCtrlItem g_brd_pwr_ctrl_items_[]  = 
{{DATA_G_BRD_PWR_CTRL_ITEMS_}};

static Brd_TPwrCtrlBase g_brd_pwr_ctrl_base_[] = {{DATA_G_BRD_PWR_CTRL_BASE_}};

Brd_TPwrCtrlAttr g_brd_pwr_ctrl_attr = 
{{DATA_G_BRD_PWR_CTRL_ATTR}};

static void Brd_PwrCtrlSet5vPerEnable(Bool enable)
{
    Brd_PwrCtrlSetBaseOn(kBrd_PwrCtrlBaseId5vPer, enable);
}

static void Brd_PwrCtrlSet3v3PerEnable(Bool enable)
{
    Brd_PwrCtrlSetBaseOn(kBrd_PwrCtrlBaseId3v3Per, enable);
}

static void Brd_PwrCtrlSet5VMainEnable(Bool enable)
{
    Brd_PwrCtrlSetBaseOn(kBrd_PwrCtrlBaseId5vMain, enable);
}
