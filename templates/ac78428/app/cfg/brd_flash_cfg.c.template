void Brd_FlashSdNandDoEnable(Bool enable)
{
    if (enable)
    {
        TDrvGpioSetLevel(&g_drv_gpio, g_brd_flash_sd_nand_pwr_pin_.group, g_brd_flash_sd_nand_pwr_pin_.pin, !g_brd_flash_sd_nand_pwr_pin_.reverse);
    }
    else
    {
        TDrvGpioSetLevel(&g_drv_gpio, g_brd_flash_sd_nand_pwr_pin_.group, g_brd_flash_sd_nand_pwr_pin_.pin, g_brd_flash_sd_nand_pwr_pin_.reverse);
    }
}

