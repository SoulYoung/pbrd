Int32 Brd_CanDoPowerSupply(Brd_THandle handle, Int32 power)
{
    Int32 result = kBrd_ErrorCodeNotSupportLine;

    switch (power)
    {
    case kBrd_PowerSupplyOn:
        {
            result = kBrd_ErrorCodeSuccess;
        }
        break;

    case kBrd_PowerSupplyOff:
        {
            result = kBrd_ErrorCodeSuccess;
        }
        break;

    default:
        break;
    }

    return result;
}
