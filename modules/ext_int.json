{
  "format": "pbrd-module",
  "schema_version": 1,
  "id": "ext_int",
  "name": "外部中断",
  "configuration_mode": "instances",
  "configuration_status": "template-adapter",
  "fields": [
    {
      "key": "pin",
      "label": "中断引脚",
      "type": "gpio",
      "value": "",
      "opts": []
    },
    {
      "key": "run_trigger",
      "label": "运行触发",
      "type": "select",
      "value": "both",
      "opts": [
        "disabled",
        "rising",
        "falling",
        "both"
      ]
    },
    {
      "key": "sleep_trigger",
      "label": "休眠触发",
      "type": "select",
      "value": "falling",
      "opts": [
        "disabled",
        "rising",
        "falling",
        "both"
      ]
    },
    {
      "key": "pull",
      "label": "上下拉",
      "type": "select",
      "value": "disabled",
      "opts": [
        "disabled",
        "up",
        "down"
      ]
    }
  ],
  "dependencies": [
    "drv.gpio",
    "drv.irq"
  ],
  "implementations": [],
  "sources": {
    "board_wrapper": "product/src/brd/{version}/{target}/src/brd_ext_int.c",
    "board_configuration": "product/src/brd/{version}/{target}/cfg/brd_ext_int_cfg.c",
    "platform_header": "product/src/brd/{mcu}/brd_ext_int_{mcu}.h"
  },
  "notes": "配置字段需要对照实际驱动及板级接口审核。未使用不代表不支持。",
  "bus_kinds": [
    "spi"
  ]
}
